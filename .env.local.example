# VendSoft API (HTTP Basic: key as username, customer id as password)
VENDSOFT_API_KEY=your_vendsoft_api_key_here
VENDSOFT_CUSTOMER_ID=your_vendsoft_customer_id_here

# Anthropic API key (for future Claude Q&A feature)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Auth (Supabase, email/password) ---
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- HaHa velocity reports (/machines) ---
# HaHa Open Platform API (server-only)
HAHA_APP_KEY=your_haha_app_key
HAHA_APP_SECRET=your_haha_app_secret
HAHA_API_BASE_URL=https://thor-openapi.hahavending.com
# Supabase service-role key: server-only, used by the cron route and bootstrap scripts
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Shared secret Vercel Cron sends as "Authorization: Bearer <secret>"
CRON_SECRET=any_long_random_string

# --- Moneta Market operator portal (read-only staff user) ---
MONETA_EMAIL=your_moneta_staff_email
MONETA_PASSWORD=your_moneta_staff_password
MONETA_BASE_URL=https://www.monetamarket.com/NanoMarketATXWeb/
